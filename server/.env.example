# Copy this file to .env and add values from your own Discord application.
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
DISCORD_BOT_TOKEN=replace-me
DISCORD_GUILD_ID=replace-me
DISCORD_ADMIN_ROLE_ID=replace-me
STAFFLISTROLE=
SESSION_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
PORT=4000
NODE_ENV=development
